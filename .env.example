NODE_ENV=development
PORT=3000
JWT_SECRET=replace_with_a_long_random_secret_before_deployment
JWT_EXPIRES_IN=8h
DATABASE_URL=postgres://salesapp:salesapp_dev_password@localhost:5432/salesforce
CORS_ORIGIN=http://localhost:5173

# SAP integration placeholder. Keep credentials on the backend, never in the mobile app.
# The SAP engineer should fill these after confirming the SAP product and API type.
SAP_MODE=disabled
SAP_BASE_URL=
SAP_COMPANY_DB=
SAP_USERNAME=
SAP_PASSWORD=
SAP_AUTH_TYPE=service-layer
SAP_TIMEOUT_MS=15000
